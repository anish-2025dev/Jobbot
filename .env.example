# JobBot configuration. Copy to .env and fill the REQUIRED block.
# Everything else has a working default (shown commented out).

# ---------------------------------------------------------------- REQUIRED
# docker compose: host "db". Supabase: the DIRECT or SESSION connection string
# (port 5432), never the transaction pooler (6543).
DATABASE_URL=postgresql+psycopg://jobbot:jobbot@db:5432/jobbot
# Password for the bundled Postgres container; change both this and the one in DATABASE_URL above
# on any machine other people can reach.
POSTGRES_PASSWORD=jobbot
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
REDIS_URL=redis://redis:6379/0

# Encrypts Gmail tokens, ATS passwords, TOTP and API keys at rest. Never change
# it after users connect accounts (they would have to reconnect).
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
# Signs login tokens and OAuth state. Changing it signs everyone out.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Operator key for scripts and admin endpoints (X-API-Key header).
ADMIN_API_KEY=
# Where the dashboard is reachable; used for the Gmail OAuth redirect and links in alerts.
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- notifications
# Create a bot with @BotFather, paste the token, then: docker compose --profile telegram up -d
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------- LLM (optional)
# none = deterministic resume selection, template cover letters and rule-based
# mail classification (everything still works). anthropic or openai
# (any OpenAI-compatible endpoint: OpenAI, Groq, OpenRouter, or local Ollama for privacy).
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_CHEAP_MODEL=          # extraction, classification, form questions
# LLM_STRONG_MODEL=         # resume tailoring, cover letters, outreach wording
# EMBEDDING_PROVIDER=hashing   # or ollama (nomic-embed-text v1.5, truncated to 256 dims)
# OLLAMA_URL=http://ollama:11434

# ---------------------------------------------------------------- Tier B aggregators (optional)
# JSEARCH_API_KEY=            # RapidAPI key
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=             # free: https://jooble.org/api/about (aggregates Naukri, Shine, TimesJobs, company sites)
# FINDWORK_API_KEY=           # free: https://findwork.dev/developers
# AGGREGATOR_QUERIES_PER_RUN=4

# ---------------------------------------------------------------- accounts
# ALLOW_SIGNUP=true           # false = private instance (create users with: python -m app.cli create-admin)
# DB_API_ROLE=jobbot_api      # migration 0003; user requests run under it so row-level security applies

# ---------------------------------------------------------------- storage budget (C1)
# DB_BUDGET_MB=300
# DB_WARN_PCT=70              # jobs retention drops to 3 days
# DB_PAUSE_PCT=90             # ingestion pauses, admins alerted
# JOBS_RETENTION_DAYS=7
# JOBS_RETENTION_DAYS_TIGHT=3
# SEEN_JOBS_RETENTION_DAYS=7
# JD_SIGNATURE_RETENTION_DAYS=60
# RECIPE_CACHE_DAYS=7
# MAIL_ACTIONS_DAYS=30
# NO_REPLY_DELETE_DAYS=45
# LEDGER_MIN_DAYS=90

# ---------------------------------------------------------------- caps (never relaxed for volume)
# COMPANY_CAP_PER_30D=3       # C5
# COMPANY_GAP_HOURS=3         # C6
# MAX_COMPANIES=1000          # C7
# WAITING_LIST_MAX=30         # C8
# WAITING_LIST_TTL_HOURS=24

# ---------------------------------------------------------------- scoring (C10)
# MIN_SCORE=0.60
# STRETCH_MIN=0.50
# BUCKET_HIGH=0.80
# BUCKET_MEDIUM=0.65
# REFERRAL_MULTIPLIER=1.5
# REPOST_HAMMING_MAX=6
# REPOST_WINDOW_DAYS=60

# ---------------------------------------------------------------- resume engine
# RESUME_ENGINE=auto          # auto | tectonic | xelatex | pdflatex | typst
# RESUME_PAPER=a4paper        # or letterpaper
# RECIPE_REUSE_SIMILARITY=0.92
# MAX_ONE_PAGE_LOOPS=5

# ---------------------------------------------------------------- application engine
# APPLY_WORKERS=1             # 5-8 on a 4-core / 8 GB VM
# GENERIC_ADAPTER_ENABLED=true
# SCREENSHOT_STORE=none       # screenshots are skipped (C2)

# ---------------------------------------------------------------- referral outreach (C14, C15)
# REFERRAL_HOLD_HOURS=24
# OUTREACH_DAILY_JOBS=10
# OUTREACH_DAILY_EMAILS=30
# OUTREACH_CONTACTS_PER_JOB=3
# OUTREACH_COMPANY_CONTACTS_30D=3
# OUTREACH_REVIEW_DAYS=7
# OUTREACH_APPROVAL_TIMEOUT_HOURS=24
# BOUNCE_PAUSE_RATE=0.03
# OUTREACH_PAUSE_DAYS=7

# ---------------------------------------------------------------- mail (C13)
# POSITIVE_MAIL_MIN_DAYS=7
# MAIL_DELETE_MODE=trash      # permanent needs the full mail scope
