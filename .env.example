# Local compose: host is "db" from inside containers, "localhost" from your shell.
DATABASE_URL=postgresql+psycopg://jobbot:jobbot@db:5432/jobbot
# Supabase: use the DIRECT or SESSION connection string (port 5432), not 6543.
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://redis:6379/0

# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

TELEGRAM_BOT_TOKEN=

# Optional overrides (defaults in app/config.py)
DB_BUDGET_MB=300
MIN_SCORE=0.60
MAX_COMPANIES=1000
